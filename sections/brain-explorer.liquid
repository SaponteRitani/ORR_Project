{%- comment -%}
  Brain Explorer — scroll-triggered interactive section.
  The figure starts faded (like the site watermark) and sharpens as it scrolls
  into view; hotspots wake up in a cascade once visible. Game over = scroll on.
  Hotspots are framed by RESEARCH FOCUS (illustrative, not anatomical).
{%- endcomment -%}
<section class="brain-explorer section-soft" id="brainExplorer">
  <div class="container">
    <p class="section-eyebrow">Interactive</p>
    <h2>Explore by Research Focus</h2>
    <p class="section-sub">Six fields of study live inside this illustration. Find them all.</p>

    <div class="explorer-stage" id="explorerStage">
      <div class="explorer-progress"><span id="expCount">0 of 6 discovered</span></div>
      <div class="brain-figure">
        <img src="{{ 'brain-bg.jpg' | asset_url }}" alt="Illustrated brain — tap the markers to explore research areas" loading="lazy">
      </div>
    </div>
    <p class="explorer-note">Illustrative only — marker positions are artistic, not anatomical.</p>
  </div>
</section>
<style>
.brain-explorer{padding:5rem 0;text-align:center;overflow:hidden;}
.brain-explorer .section-eyebrow{color:var(--teal-dark);font-weight:700;font-size:.8rem;letter-spacing:.18em;text-transform:uppercase;margin-bottom:.6rem;}
.brain-explorer h2{font-size:clamp(1.7rem,3.4vw,2.5rem);margin-bottom:.5rem;}
.brain-explorer .section-sub{color:var(--text-muted);margin-bottom:2.2rem;}
.explorer-stage{position:relative;width:min(480px,88vw);margin:0 auto;}
.explorer-progress{font-size:.82rem;font-weight:600;color:var(--teal-dark);margin-bottom:1rem;letter-spacing:.04em;}
.brain-figure{position:relative;opacity:.22;filter:saturate(.6);transform:scale(.985);transition:opacity 1.2s ease,filter 1.2s ease,transform 1.2s ease;}
.brain-explorer.in-view .brain-figure{opacity:1;filter:none;transform:none;}
.brain-figure img{width:100%;display:block;border-radius:20px;background:#fff;box-shadow:0 18px 50px rgba(14,124,138,.10);}
.exp-hotspot{position:absolute;width:38px;height:38px;transform:translate(-50%,-50%);cursor:pointer;z-index:2;opacity:0;pointer-events:none;transition:opacity .5s ease;}
.brain-explorer.in-view .exp-hotspot{opacity:1;pointer-events:auto;}
.brain-explorer.in-view .exp-hotspot:nth-of-type(1){transition-delay:.15s;}
.brain-explorer.in-view .exp-hotspot:nth-of-type(2){transition-delay:.3s;}
.brain-explorer.in-view .exp-hotspot:nth-of-type(3){transition-delay:.45s;}
.brain-explorer.in-view .exp-hotspot:nth-of-type(4){transition-delay:.6s;}
.brain-explorer.in-view .exp-hotspot:nth-of-type(5){transition-delay:.75s;}
.brain-explorer.in-view .exp-hotspot:nth-of-type(6){transition-delay:.9s;}
.exp-hotspot .dot{position:absolute;inset:9px;border-radius:50%;background:rgba(14,124,138,.92);box-shadow:0 0 0 4px rgba(14,124,138,.16);transition:transform .2s ease,background .2s ease;}
.exp-hotspot .ping{position:absolute;inset:0;border-radius:50%;border:2px solid rgba(14,124,138,.5);animation:expPing 2.4s ease-out infinite;}
@keyframes expPing{0%{transform:scale(.55);opacity:1;}80%,100%{transform:scale(1.18);opacity:0;}}
.exp-hotspot:hover .dot{transform:scale(1.18);}
.exp-hotspot.found .dot{background:#0a5f6b;box-shadow:0 0 0 4px rgba(10,95,107,.14);}
.exp-hotspot.found .ping{display:none;}
.exp-hotspot.found .dot::after{content:'✓';position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px;font-weight:700;}
.exp-card{position:absolute;left:50%;bottom:calc(100% + 12px);transform:translateX(-50%) translateY(8px);width:215px;background:#fff;border:1px solid var(--border);border-radius:14px;padding:14px 16px;box-shadow:0 16px 38px rgba(0,0,0,.14);opacity:0;pointer-events:none;transition:opacity .22s ease,transform .22s ease;z-index:6;text-align:left;}
.exp-hotspot.open .exp-card{opacity:1;pointer-events:auto;transform:translateX(-50%) translateY(0);}
.exp-card h3{font-size:.98rem;margin-bottom:4px;}
.exp-card p{font-size:.8rem;color:var(--text-muted);margin-bottom:10px;line-height:1.5;}
.exp-card a{font-size:.82rem;font-weight:700;color:var(--teal-dark);}
.explorer-note{margin-top:1.4rem;font-size:.76rem;color:var(--text-faint);}
.brain-explorer .win-line{display:none;margin-top:1.1rem;font-weight:700;color:var(--teal-dark);}
.brain-explorer .win-line.show{display:block;}
@media (prefers-reduced-motion:reduce){
  .brain-figure{opacity:1;filter:none;transform:none;transition:none;}
  .exp-hotspot{opacity:1;pointer-events:auto;transition:none;}
  .exp-hotspot .ping{animation:none;display:none;}
}
</style>
<script>
(function(){
  var sec = document.getElementById('brainExplorer');
  if(!sec) return;
  var stage = document.getElementById('explorerStage');
  var spots = [
    { focus:'Cognitive',        compounds:'Semax',                    note:'Focus and clarity research.',        x:36, y:25, link:'/collections/all#f-cognitive' },
    { focus:'GH Axis',          compounds:'Ipamorelin · CJC-1295',    note:'Growth-hormone axis research.',     x:64, y:25, link:'/collections/all#f-ghaxis' },
    { focus:'Recovery & Repair',compounds:'BPC-157 · TB-500',         note:'Tissue recovery research.',          x:31, y:49, link:'/collections/all#f-recovery' },
    { focus:'Skin & Appearance',compounds:'GHK-Cu',                   note:'Skin and appearance research.',      x:69, y:49, link:'/collections/all#f-skin' },
    { focus:'Behavioral',       compounds:'Oxytocin',                 note:'Social behavior research.',          x:37, y:71, link:'/collections/all' },
    { focus:'Blends & Stacks',  compounds:'Curated combinations',     note:'Researcher-assembled stacks.',       x:63, y:71, link:'/collections/all#f-blends' }
  ];
  var found = 0;
  var countEl = document.getElementById('expCount');
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      if(en.isIntersecting){ sec.classList.add('in-view'); io.disconnect(); }
    });
  }, { threshold: 0.3 });
  io.observe(sec);
  spots.forEach(function(s){
    var h = document.createElement('button');
    h.type = 'button';
    h.className = 'exp-hotspot';
    h.style.left = s.x + '%';
    h.style.top = s.y + '%';
    h.setAttribute('aria-label', 'Explore ' + s.focus);
    h.innerHTML = '<span class="ping"></span><span class="dot"></span>' +
      '<span class="exp-card"><h3>' + s.focus + '</h3><p><strong>' + s.compounds + '</strong><br>' + s.note + '</p>' +
      '<a href="' + s.link + '">Shop ' + s.focus + ' →</a></span>';
    h.addEventListener('click', function(e){
      if(e.target.closest('a')) return; /* let the Shop link navigate cleanly */
      e.stopPropagation();
      var wasOpen = h.classList.contains('open');
      stage.querySelectorAll('.exp-hotspot.open').forEach(function(o){ o.classList.remove('open'); });
      if(!wasOpen){
        h.classList.add('open');
        if(!h.classList.contains('found')){
          h.classList.add('found');
          found++;
          countEl.textContent = found + ' of 6 discovered';
          if(found === 6){
            var w = document.createElement('p');
            w.className = 'win-line show';
            w.textContent = 'All six found — nice exploring.';
            sec.querySelector('.container').appendChild(w);
          }
        }
      }
    });
    stage.querySelector('.brain-figure').appendChild(h);
  });
  document.addEventListener('click', function(){
    stage.querySelectorAll('.exp-hotspot.open').forEach(function(o){ o.classList.remove('open'); });
  });
})();
</script>
{% schema %}
{ "name": "Brain Explorer", "settings": [] }
{% endschema %}
