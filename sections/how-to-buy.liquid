{%- comment -%} How to buy (from mockup) {%- endcomment -%}
<!-- How to buy -->
  <section class="section">
    <div class="container">
      <div class="center">
        <span class="eyebrow">Simple, transparent ordering</span>
        <h2>How to Buy</h2>
        <p class="lead">Six steps from catalog to bench — with verification built in at every stage.</p>
      </div>
      <div class="steps">
        <div class="step">
          <h3>Browse the catalog</h3>
          <p>Pick a compound or blend. Every listing shows specs, pricing, and availability up front.</p>
        </div>
        <div class="step">
          <h3>Read the COA first</h3>
          <p>Each product page carries its batch's certificate of analysis. Review it before you commit.</p>
        </div>
        <div class="step">
          <h3>Confirm eligibility</h3>
          <p>Our compounds are for laboratory research use only. Purchasers must be 21+ and qualified researchers.</p>
        </div>
        <div class="step">
          <h3>Check out securely</h3>
          <p>Encrypted checkout with discreet, protective packaging on every order.</p>
        </div>
        <div class="step">
          <h3>Fast dispatch</h3>
          <p>Orders placed before 2 PM ET ship the same business day, lyophilized and temperature-stable.</p>
        </div>
        <div class="step">
          <h3>Verify on arrival</h3>
          <p>The batch number on your vial matches the published COA. Mismatch? Full refund, no questions.</p>
        </div>
      </div>
    </div>
  </section>
{% schema %}
{ "name": "How to buy", "settings": [] }
{% endschema %}
