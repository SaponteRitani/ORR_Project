{%- comment -%} Newsletter (from mockup) {%- endcomment -%}
<!-- Newsletter -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="newsletter">
        <h2>Batch-Release Alerts</h2>
        <p>New lots, restocks, and research-education articles. One email a week, unsubscribe anytime. Researchers 21+ only.</p>
        <form class="news-form" action="#" method="post">
          <input type="email" name="email" placeholder="you@yourlab.org" aria-label="Email address" required>
          <button type="submit" class="btn btn-primary">Subscribe</button>
        </form>
        <p class="news-fine">By subscribing you confirm you are 21 or older and requesting research-use product information only.</p>
      </div>
    </div>
  </section>
{% schema %}
{ "name": "Newsletter", "settings": [] }
{% endschema %}
