{%- comment -%}
  Trending Now — curated trending products + research topics.
  Uses a collection (sort by best-selling when products go live) with
  placeholder cards in preview mode. Manual curation via section settings.
{%- endcomment -%}
<section class="section section-soft trending-section">
  <div class="container">
    <div class="center">
      <span class="eyebrow">Trending Now</span>
      <h2>{{ section.settings.heading | default: "What researchers are exploring" }}</h2>
      <p class="lead">{{ section.settings.subheading | default: "The compounds and topics getting the most attention in the lab community right now." }}</p>
    </div>
    {%- assign trend = collections[section.settings.collection] -%}
    <div class="product-grid">
      {%- if trend and trend.products.size > 0 -%}
        {%- for product in trend.products limit: section.settings.limit -%}
          {% render 'product-card', product: product, badge: 'Trending' %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Preview placeholders until products are added {%- endcomment -%}
        {%- assign trending_names = "BPC-157,TB-500,GHK-Cu,Ipamorelin,Semax,Selank" | split: "," -%}
        {%- for name in trending_names limit: section.settings.limit -%}
        <article class="product-card product-card--placeholder" aria-hidden="true">
          <div class="trend-badge">Trending</div>
          <div class="vial-stage">
            <div class="vial" style="--hue:190; --fill:60%;"><div class="vial-cap"></div><div class="vial-neck"></div>
              <div class="vial-body"><div class="vial-liquid"></div><div class="vial-shine"></div>
                <div class="vial-label"><span class="vl-name">OranR</span><span class="vl-sub">Coming soon</span><span class="vl-rulo">Research Use Only</span></div></div></div>
          </div>
          <div class="card-body">
            <div class="card-cat">Trending compound</div>
            <h3 class="brand-name">{{ name }}</h3>
            <div class="card-price"><span class="price">—</span></div>
          </div>
        </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
    <div class="center mt-2">
      <a href="/blogs/news" class="btn btn-outline">Explore Research Topics</a>
    </div>
  </div>
</section>
<style>
.trending-section .trend-badge{display:inline-block;background:#0e7c8a;color:#fff;font-size:0.72rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;padding:0.3rem 0.7rem;border-radius:20px;margin-bottom:0.5rem;}
.trending-section .product-card{position:relative;}
</style>
{% schema %}
{
  "name": "Trending Now",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What researchers are exploring" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "The compounds and topics getting the most attention in the lab community right now." },
    { "type": "collection", "id": "collection", "label": "Trending collection (use best-selling sort)" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "default": 6 }
  ],
  "presets": [{ "name": "Trending Now" }]
}
{% endschema %}
