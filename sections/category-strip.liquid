          <span class="cat-link">Browse →</span>
        </a>
        <a href="/collections/all#f-oral" class="cat-card">
          <img class="cat-icon" src="{{ 'icon-blends.png' | asset_url }}" alt="" aria-hidden="true">
          <h3>Oral Capsules</h3>
          <p>Capsule formats for comparative bioavailability research models.</p>
          <span class="cat-link">Browse →</span>
        </a>
        <a href="/collections/all#f-blends" class="cat-card">
          <img class="cat-icon" src="{{ 'icon-lab.png' | asset_url }}" alt="" aria-hidden="true">
