{%- comment -%} Why choose us (from mockup) {%- endcomment -%}
<!-- Why choose us -->
  <section class="section section-soft">
    <div class="container">
      <div class="center">
        <span class="eyebrow">The OranR standard</span>
        <h2>Why Researchers Choose OranR</h2>
      </div>
      <div class="promise-grid">
        <div class="promise">
          <img class="p-icon" src="{{ 'icon-microscope.png' | asset_url }}" alt="" aria-hidden="true">
          <h3>Seven assays, every batch</h3>
          <p>No spot-checking, no "representative" COAs. The exact lot you receive is the lot that was tested.</p>
        </div>
        <div class="promise">
          <img class="p-icon" src="{{ 'icon-certificate.png' | asset_url }}" alt="" aria-hidden="true">
          <h3>COAs before sale, not after</h3>
          <p>Documentation is published on the product page before a batch is listed. If you can't read it, you can't buy it.</p>
        </div>
        <div class="promise">
          <img class="p-icon" src="{{ 'icon-shield.png' | asset_url }}" alt="" aria-hidden="true">
          <h3>COA-mismatch guarantee</h3>
          <p>Have an independent lab test your vial. If the results don't match our published COA, we refund the order in full.</p>
        </div>
      </div>
    </div>
  </section>
{% schema %}
{ "name": "Why choose us", "settings": [] }
{% endschema %}
