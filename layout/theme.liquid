<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cdefs%3E%3Cfilter id='g' filterUnits='userSpaceOnUse' x='-20' y='-20' width='104' height='104'%3E%3CfeGaussianBlur stdDeviation='2.2'/%3E%3C/filter%3E%3C/defs%3E%3Crect width='64' height='64' rx='14' fill='%230a0f1e'/%3E%3Crect x='6' y='6' width='52' height='52' rx='10' fill='none' stroke='%2338bdf8' stroke-width='3' opacity='.85' filter='url(%23g)'/%3E%3Ctext x='32' y='44' font-family='system-ui,sans-serif' font-size='34' font-weight='800' text-anchor='middle' fill='%23dc2626' filter='url(%23g)'%3ER%3C/text%3E%3Ctext x='32' y='44' font-family='system-ui,sans-serif' font-size='34' font-weight='800' text-anchor='middle' fill='%23fecaca'%3ER%3C/text%3E%3C/svg%3E">
  <title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}</title>
  {%- if page_description -%}
  <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}
  <link rel="canonical" href="{{ canonical_url }}">
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
  {{ 'styles.css' | asset_url | stylesheet_tag }}
  <style>
    :root {
      --teal: {{ settings.color_accent }};
      --teal-dark: {{ settings.color_accent_dark }};
      --sale: {{ settings.color_accent }};
      --navy: {{ settings.color_ink }};
      --text: {{ settings.color_ink }};
    }
    /* Faint fixed brain watermark — stays put while scrolling */
    body::before {
      content: ''; position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background: url('{{ 'brain-bg.jpg' | asset_url }}') center 12% / min(1060px, 94vw) no-repeat;
      opacity: 0.16;
    }
    #MainContent, .site-header, .site-footer, .announce { position: relative; z-index: 1; }
  </style>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "description": "Supplier of high-purity research peptides for laboratory use."
  }
  </script>
</head>
<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.suffix }}{% endif %}">
  {% section 'announcement-bar' %}
  {% section 'header' %}
  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>
  {% section 'footer' %}
  {{ 'main.js' | asset_url | script_tag }}
  <!-- OR&R Age Gate (21+) -->
  <div id="age-gate" style="display:none;position:fixed;inset:0;z-index:99999;background:rgba(5,8,18,0.97);align-items:center;justify-content:center;">
    <div style="text-align:center;max-width:420px;padding:40px 32px;background:#0b1120;border:1px solid rgba(56,189,248,0.25);border-radius:16px;">
      <div style="font-size:2.2rem;font-weight:800;letter-spacing:2px;color:#fff;margin-bottom:8px;">OR<span style="color:#38bdf8;">&amp;</span>R</div>
      <p style="color:#94a3b8;font-size:0.95rem;margin-bottom:6px;">Premium Research Peptides</p>
      <p style="color:#e2e8f0;font-size:1.05rem;margin:20px 0 6px;">Are you 21 years or older?</p>
      <p style="color:#64748b;font-size:0.82rem;margin-bottom:28px;">You must be 21+ to enter this site.<br>All products are for laboratory research use only.</p>
      <div style="display:flex;gap:12px;justify-content:center;">
        <button id="age-yes" style="padding:14px 36px;background:#38bdf8;color:#020617;border:none;border-radius:10px;font-weight:700;font-size:1rem;cursor:pointer;">Yes, I'm 21+</button>
        <button id="age-no" style="padding:14px 36px;background:transparent;color:#94a3b8;border:1px solid #334155;border-radius:10px;font-weight:600;font-size:1rem;cursor:pointer;">No</button>
      </div>
    </div>
  </div>
  <script>
  (function(){
    try {
      if (localStorage.getItem('orandr_age_ok') === '1') return;
    } catch(e) {}
    var gate = document.getElementById('age-gate');
    gate.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    document.getElementById('age-yes').addEventListener('click', function(){
      try { localStorage.setItem('orandr_age_ok','1'); } catch(e) {}
      gate.style.display = 'none';
      document.body.style.overflow = '';
    });
    document.getElementById('age-no').addEventListener('click', function(){
      window.location.href = 'https://www.google.com';
    });
  })();
  </script>
</body>
</html>
